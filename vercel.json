{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!api/|regle(?:/|$)|sourate(?:/|$)|en(?:/|$)|aso(?:/|$)|robots\\.txt|sitemap\\.xml|manifest\\.webmanifest|indexnow\\.txt|og\\.png|icons/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
