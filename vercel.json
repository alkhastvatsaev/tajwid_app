{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!api/|regle(?:/|$)|sourate(?:/|$)|en(?:/|$)|id(?:/|$)|aso(?:/|$)|privacy(?:/|$)|apprendre-tajwid(?:/|$)|tajwid-microphone(?:/|$)|llms\\.txt|robots\\.txt|sitemap\\.xml|manifest\\.webmanifest|indexnow\\.txt|og\\.png|icons/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }]
    }
  ]
}
