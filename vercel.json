{
  "version": 2,
  "framework": null,
  "buildCommand": "echo legacy-static",
  "outputDirectory": "public",
  "installCommand": "echo skip",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!api/|regle(?:/|$)|sourate(?:/|$)|en(?:/|$)|id(?:/|$)|ar(?:/|$)|aso(?:/|$)|privacy(?:/|$)|apprendre-tajwid(?:/|$)|tajwid-microphone(?:/|$)|best-tajwid-app-for-beginners(?:/|$)|llms\\.txt|robots\\.txt|sitemap\\.xml|manifest\\.webmanifest|indexnow\\.txt|BingSiteAuth\\.xml|og\\.png|icons/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }]
    }
  ]
}
